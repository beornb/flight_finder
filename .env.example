# SQLite database used by Prisma (path relative to the project root)
DATABASE_URL="file:./prisma/dev.db"

# Flight data provider. Ignav (https://ignav.com) is the default when a key is
# set; without one the app falls back to the built-in deterministic mock.
IGNAV_API_KEY=""
# 2-letter country code controlling fare currency/locale (default AT → EUR)
IGNAV_MARKET="AT"

# Duffel (https://duffel.com) as an alternative provider; test-mode keys
# (duffel_test_...) return free synthetic offers.
DUFFEL_API_KEY=""
# SerpApi (https://serpapi.com/) as a third provider — Google Flights data,
# billed per search.
SERP_API_KEY=""

# Fallback provider when a request names none: "ignav", "duffel", or "mock".
# The search form's "Flight data" dropdown normally decides per search.
FLIGHT_PROVIDER=""
